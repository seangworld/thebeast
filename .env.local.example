# Local development environment variables.
# Copy this file to `.env.local` and fill in values for your development/test Supabase project.
# Do NOT commit `.env.local` (it is ignored by .gitignore).

# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Required (set these to your DEV/Test Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public BeastOS origin. Production should use
# https://thebeast.seangworld.com. Leave blank locally and in dynamic previews
# to use the current origin.
NEXT_PUBLIC_BEAST_SITE_URL=

# BeastOS authentication experience.
# Public registration preserves the current open-registration behavior unless
# explicitly set to false. Password sign-in remains hidden unless enabled.
NEXT_PUBLIC_BEAST_PUBLIC_REGISTRATION_ENABLED=true
NEXT_PUBLIC_BEAST_PASSWORD_SIGN_IN_ENABLED=false

# Must match the hosted Supabase Email OTP Expiration used by invitation links.
# Supabase defaults to one hour.
BEAST_INVITATION_EXPIRY_HOURS=1

# Server-only. Required for Stripe webhook synchronization and BeastAdmin Auth
# account editing. Never prefix this value with NEXT_PUBLIC_ or expose it to
# browser code.
SUPABASE_SERVICE_ROLE_KEY=

# SEANGWORLD Intelligence. All variables below are server-only. Snapshot JSON
# must come from a verified server synchronization job; never hand-author data.
SEANGWORLD_GOOGLE_SERVICE_ACCOUNT_EMAIL=
SEANGWORLD_GOOGLE_PRIVATE_KEY=
SEANGWORLD_GA4_PROPERTY_ID=
SEANGWORLD_GA4_STATUS=
SEANGWORLD_GA4_SNAPSHOT_JSON=
SEANGWORLD_GA4_LAST_SYNCHRONIZATION_AT=
SEANGWORLD_GA4_LAST_SUCCESSFUL_SYNCHRONIZATION_AT=
SEANGWORLD_SEARCH_CONSOLE_SITE_URL=
SEANGWORLD_SEARCH_CONSOLE_STATUS=
SEANGWORLD_SEARCH_CONSOLE_SNAPSHOT_JSON=
SEANGWORLD_SEARCH_CONSOLE_LAST_SYNCHRONIZATION_AT=
SEANGWORLD_SEARCH_CONSOLE_LAST_SUCCESSFUL_SYNCHRONIZATION_AT=
SEANGWORLD_FIRST_PARTY_ANALYTICS_ENABLED=false
SEANGWORLD_FIRST_PARTY_STATUS=
SEANGWORLD_FIRST_PARTY_SNAPSHOT_JSON=
SEANGWORLD_FIRST_PARTY_LAST_SYNCHRONIZATION_AT=
SEANGWORLD_FIRST_PARTY_LAST_SUCCESSFUL_SYNCHRONIZATION_AT=
