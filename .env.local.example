# Local development environment variables.
# Copy this file to `.env.local` and fill in values for your development/test Supabase project.
# Do NOT commit `.env.local` (it is ignored by .gitignore).

# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Required (set these to your DEV/Test Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public BeastOS origin. Production should use
# https://thebeast.seangworld.com. Leave blank locally and in dynamic previews
# to use the current origin.
NEXT_PUBLIC_BEAST_SITE_URL=

# BeastOS authentication experience.
# Public registration preserves the current open-registration behavior unless
# explicitly set to false. Password sign-in remains hidden unless enabled.
NEXT_PUBLIC_BEAST_PUBLIC_REGISTRATION_ENABLED=true
NEXT_PUBLIC_BEAST_PASSWORD_SIGN_IN_ENABLED=false
# Expose Google only after the corresponding Supabase Auth provider is enabled
# and verified for the current environment. Never reuse unrelated Google OAuth
# credentials merely because they already exist in Vercel.
NEXT_PUBLIC_BEAST_GOOGLE_AUTH_ENABLED=false

# Must match the hosted Supabase Email OTP Expiration used by invitation links.
# Supabase defaults to one hour.
BEAST_INVITATION_EXPIRY_HOURS=1

# Server-only. Required for Stripe webhook synchronization and BeastAdmin Auth
# account editing. Never prefix this value with NEXT_PUBLIC_ or expose it to
# browser code.
SUPABASE_SERVICE_ROLE_KEY=

# BA-CMD-001A server-to-server publication boundary. Use a unique random value
# of at least 32 characters in each environment. Never expose it to browser code.
BEASTFUSION_PROJECTION_PUBLISH_SECRET=

# SEANGWORLD Intelligence. All variables below are server-only. The owner API
# reads GA4 and Search Console directly when their identifiers and the shared
# service-account credentials are configured.
SEANGWORLD_GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste PKCS8 PEM content with literal \n characters when the host requires a
# single-line value.
SEANGWORLD_GOOGLE_PRIVATE_KEY=
SEANGWORLD_GA4_PROPERTY_ID=
# Privacy-first browser collection. This public measurement ID identifies the
# approved GA4 web stream; it is not the numeric Data API property ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_FOOTER_SLOT=
NEXT_PUBLIC_ADSENSE_CONSENT_DEFAULT=pending

# Owner-only aggregate AdSense Management API reporting.
GOOGLE_ADSENSE_CLIENT_ID=
GOOGLE_ADSENSE_CLIENT_SECRET=
GOOGLE_ADSENSE_REFRESH_TOKEN=
GOOGLE_ADSENSE_ACCOUNT_ID=
# Optional YYYY-MM-DD boundary required before Revenue Center requests a
# lifetime custom report.
GOOGLE_ADSENSE_REPORTING_START_DATE=
# pending | disabled | enabled. Pending is the safe default.
NEXT_PUBLIC_ANALYTICS_CONSENT_DEFAULT=pending
# Numeric property explicitly approved for cross-product aggregate reporting.
# Do not copy SEANGWORLD_GA4_PROPERTY_ID here until its stream scope is verified.
BEAST_ECOSYSTEM_GA4_PROPERTY_ID=
# Use the exact Search Console property identifier, including sc-domain: or the
# trailing slash for URL-prefix properties.
SEANGWORLD_SEARCH_CONSOLE_SITE_URL=

# Legacy verified-snapshot fallback. Do not hand-author analytics data.
SEANGWORLD_GA4_STATUS=
SEANGWORLD_GA4_SNAPSHOT_JSON=
SEANGWORLD_GA4_LAST_SYNCHRONIZATION_AT=
SEANGWORLD_GA4_LAST_SUCCESSFUL_SYNCHRONIZATION_AT=
SEANGWORLD_SEARCH_CONSOLE_STATUS=
SEANGWORLD_SEARCH_CONSOLE_SNAPSHOT_JSON=
SEANGWORLD_SEARCH_CONSOLE_LAST_SYNCHRONIZATION_AT=
SEANGWORLD_SEARCH_CONSOLE_LAST_SUCCESSFUL_SYNCHRONIZATION_AT=
SEANGWORLD_FIRST_PARTY_ANALYTICS_ENABLED=false
SEANGWORLD_FIRST_PARTY_STATUS=
SEANGWORLD_FIRST_PARTY_SNAPSHOT_JSON=
SEANGWORLD_FIRST_PARTY_LAST_SYNCHRONIZATION_AT=
SEANGWORLD_FIRST_PARTY_LAST_SUCCESSFUL_SYNCHRONIZATION_AT=
