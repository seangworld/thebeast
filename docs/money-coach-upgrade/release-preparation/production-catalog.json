  "policies": [
    {
      "cmd": "ALL",
      "qual": "((auth.uid() = owner_id) AND (EXISTS ( SELECT 1\n   FROM agent_conversations conversation\n  WHERE ((conversation.id = agent_conversation_messages.conversation_id) AND (conversation.owner_id = auth.uid())))))",
      "roles": [
        "public"
      ],
      "tablename": "agent_conversation_messages",
      "permissive": "PERMISSIVE",
      "policyname": "Owners manage their agent conversation messages",
      "with_check": "((auth.uid() = owner_id) AND (EXISTS ( SELECT 1\n   FROM agent_conversations conversation\n  WHERE ((conversation.id = agent_conversation_messages.conversation_id) AND (conversation.owner_id = auth.uid())))))"
    },
    {
